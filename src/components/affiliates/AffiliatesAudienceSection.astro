---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { afiliadosContent } from "../../content/afiliados";
import "./affiliates-audience-section.css";
---

<Section id="publico-alvo" background="light" spacing="lg">
  <Container>
    <div class="affiliates-section-header" data-scroll-reveal="fade">
      <p class="affiliates-eyebrow">{afiliadosContent.audiences.badge}</p>
      <h2>{afiliadosContent.audiences.title}</h2>
      <p class="affiliates-section-desc">{afiliadosContent.audiences.description}</p>
    </div>

    <div class="audience-cards-grid">
      {
        afiliadosContent.audiences.items.map((item) => (
          <div class="audience-card card-interactive" data-scroll-reveal="up">
            <div class="audience-card__icon-wrap">
              {item.icon === "layout" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
              )}
              {item.icon === "code" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              )}
              {item.icon === "briefcase" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              )}
              {item.icon === "users" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              )}
            </div>

            <div class="audience-card__content">
              <h3 class="audience-card__title">{item.title}</h3>
              <p class="audience-card__subtitle">{item.subtitle}</p>
              <p class="audience-card__desc">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>
