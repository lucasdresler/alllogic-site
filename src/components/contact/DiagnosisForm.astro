---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { contatoContent } from "../../content/contato";
import "./diagnosis-form.css";

const { fields, consentNote, submitLabel, sendingLabel, successMessage, errorMessage } =
  contatoContent.form;

// Conteúdo repassado ao script do cliente via atributos data-*, para que as
// mensagens continuem vindo de src/content/contato.ts em vez de hardcoded no
// script (ver src/components/README.md — componentes não definem conteúdo próprio).
const fieldMessages = JSON.stringify({
  company: { required: fields.company.requiredMessage },
  contactName: { required: fields.contactName.requiredMessage },
  phone: { required: fields.phone.requiredMessage, format: fields.phone.formatMessage },
  message: { required: fields.message.requiredMessage, minLength: fields.message.minLengthMessage },
});
---

<Section id="diagnostico-form">
  <Container>
    <form
      class="diagnosis-form"
      data-diagnosis-form
      data-messages={fieldMessages}
      data-submit-label={submitLabel}
      data-sending-label={sendingLabel}
      data-success-message={successMessage}
      data-error-message={errorMessage}
      novalidate
    >
      <div class="diagnosis-form__field">
        <label for="company">{fields.company.label}</label>
        <input id="company" name="company" type="text" required aria-describedby="company-error" />
        <p id="company-error" class="diagnosis-form__error" role="alert" hidden></p>
      </div>

      <div class="diagnosis-form__field">
        <label for="contactName">{fields.contactName.label}</label>
        <input
          id="contactName"
          name="contactName"
          type="text"
          required
          aria-describedby="contactName-hint contactName-error"
        />
        {fields.contactName.hint && (
          <p id="contactName-hint" class="diagnosis-form__hint">{fields.contactName.hint}</p>
        )}
        <p id="contactName-error" class="diagnosis-form__error" role="alert" hidden></p>
      </div>

      <div class="diagnosis-form__field">
        <label for="phone">{fields.phone.label}</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          required
          aria-describedby="phone-hint phone-error"
        />
        {fields.phone.hint && <p id="phone-hint" class="diagnosis-form__hint">{fields.phone.hint}</p>}
        <p id="phone-error" class="diagnosis-form__error" role="alert" hidden></p>
      </div>

      <div class="diagnosis-form__field">
        <label for="message">{fields.message.label}</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          aria-describedby="message-hint message-error"
        ></textarea>
        {fields.message.hint && (
          <p id="message-hint" class="diagnosis-form__hint">{fields.message.hint}</p>
        )}
        <p id="message-error" class="diagnosis-form__error" role="alert" hidden></p>
      </div>

      <p class="diagnosis-form__consent">{consentNote}</p>

      <button type="submit" class="diagnosis-form__submit" data-diagnosis-submit>
        <span data-diagnosis-submit-label>{submitLabel}</span>
      </button>

      <p class="diagnosis-form__status" role="status" aria-live="polite" data-diagnosis-status></p>
    </form>
  </Container>
</Section>

<script>
  import { isRequired, hasMinLength, isValidBrazilianPhone } from "../../utils/validation";
  import { submitDiagnosisRequest } from "../../services/diagnosisSubmission";

  type FieldName = "company" | "contactName" | "phone" | "message";
  type FormFieldElement = HTMLInputElement | HTMLTextAreaElement;

  interface FieldMessages {
    required: string;
    format?: string;
    minLength?: string;
  }

  type Messages = Record<FieldName, FieldMessages>;

  const MESSAGE_MIN_LENGTH = 20;

  const form = document.querySelector("[data-diagnosis-form]");
  if (form instanceof HTMLFormElement) {
    // Capturado em uma nova const para preservar a tipagem HTMLFormElement
    // dentro das funções aninhadas abaixo (o TypeScript não estende o
    // estreitamento de tipo de `form` para dentro de function declarations).
    const formEl = form;

    const messages: Messages = JSON.parse(formEl.dataset.messages || "{}");

    const fieldNames: FieldName[] = ["company", "contactName", "phone", "message"];
    const fields = {} as Record<FieldName, FormFieldElement>;
    fieldNames.forEach((name) => {
      const el = formEl.querySelector(`#${name}`);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
        fields[name] = el;
      }
    });

    const statusEl = formEl.querySelector<HTMLElement>("[data-diagnosis-status]");
    const submitButton = formEl.querySelector<HTMLButtonElement>("[data-diagnosis-submit]");
    const submitLabelEl = submitButton
      ? submitButton.querySelector<HTMLElement>("[data-diagnosis-submit-label]")
      : null;

    function setFieldError(name: FieldName, message: string | null): void {
      const field = fields[name];
      if (!field) return;
      const errorEl = formEl.querySelector<HTMLElement>(`#${name}-error`);
      if (message) {
        field.setAttribute("aria-invalid", "true");
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.hidden = false;
        }
      } else {
        field.removeAttribute("aria-invalid");
        if (errorEl) {
          errorEl.textContent = "";
          errorEl.hidden = true;
        }
      }
    }

    function validateField(name: FieldName): boolean {
      const field = fields[name];
      if (!field) return true;
      const value = field.value;

      if (name === "phone") {
        if (!isRequired(value)) {
          setFieldError(name, messages.phone.required);
          return false;
        }
        if (!isValidBrazilianPhone(value)) {
          setFieldError(name, messages.phone.format ?? null);
          return false;
        }
        setFieldError(name, null);
        return true;
      }

      if (name === "message") {
        if (!isRequired(value)) {
          setFieldError(name, messages.message.required);
          return false;
        }
        if (!hasMinLength(value, MESSAGE_MIN_LENGTH)) {
          setFieldError(name, messages.message.minLength ?? null);
          return false;
        }
        setFieldError(name, null);
        return true;
      }

      if (!isRequired(value)) {
        setFieldError(name, messages[name].required);
        return false;
      }
      setFieldError(name, null);
      return true;
    }

    function validateAll(): boolean {
      let valid = true;
      fieldNames.forEach((name) => {
        if (!validateField(name)) valid = false;
      });
      return valid;
    }

    fieldNames.forEach((name) => {
      const field = fields[name];
      if (!field) return;
      field.addEventListener("blur", () => validateField(name));
    });

    formEl.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (submitButton && submitButton.disabled) return;

      const isValid = validateAll();
      if (!isValid) return;

      if (submitButton) submitButton.disabled = true;
      if (submitLabelEl) submitLabelEl.textContent = formEl.dataset.sendingLabel || "Enviando…";
      if (statusEl) {
        statusEl.textContent = "";
        statusEl.classList.remove("diagnosis-form__status--success", "diagnosis-form__status--error");
      }

      const payload = {
        company: fields.company.value.trim(),
        contactName: fields.contactName.value.trim(),
        phone: fields.phone.value.trim(),
        message: fields.message.value.trim(),
      };

      const result = await submitDiagnosisRequest(payload);

      if (submitButton) submitButton.disabled = false;
      if (submitLabelEl) submitLabelEl.textContent = formEl.dataset.submitLabel || "Vamos conversar";

      if (result.ok) {
        if (statusEl) {
          statusEl.textContent = formEl.dataset.successMessage || "";
          statusEl.classList.add("diagnosis-form__status--success");
        }
        formEl.reset();
      } else {
        if (statusEl) {
          statusEl.textContent = formEl.dataset.errorMessage || "";
          statusEl.classList.add("diagnosis-form__status--error");
        }
      }
    });
  }
</script>
