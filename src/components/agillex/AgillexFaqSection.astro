---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexContent } from "../../content/agillex";
import "./agillex-faq-section.css";

const { faq } = agillexContent;
---

<Section id="duvidas-frequentes" background="default" spacing="lg">
  <Container>
    <div class="agillex-faq" data-scroll-reveal="up">
      <div class="agillex-faq__header">
        <span class="agillex-faq__eyebrow">{faq.eyebrow}</span>
        <h2 class="agillex-faq__title">{faq.title}</h2>
        <p class="agillex-faq__description">{faq.description}</p>
      </div>

      <div class="agillex-faq__accordion">
        {
          faq.items.map((item, idx) => (
            <div class="agillex-faq__item" data-faq-item>
              <button
                type="button"
                class="agillex-faq__trigger"
                aria-expanded="false"
                aria-controls={`faq-answer-${idx}`}
                id={`faq-trigger-${idx}`}
              >
                <span class="agillex-faq__question-text">{item.question}</span>
                <span class="agillex-faq__icon" aria-hidden="true">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </span>
              </button>
              <div
                class="agillex-faq__answer"
                id={`faq-answer-${idx}`}
                role="region"
                aria-labelledby={`faq-trigger-${idx}`}
                hidden
              >
                <p class="agillex-faq__answer-text">{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<script>
  function initFaqAccordion() {
    const items = document.querySelectorAll<HTMLElement>("[data-faq-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".agillex-faq__trigger");
      const answer = item.querySelector<HTMLElement>(".agillex-faq__answer");

      if (!trigger || !answer) return;

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        // Fecha todos os outros para manter a interface limpa
        items.forEach((other) => {
          if (other !== item) {
            const otherTrigger = other.querySelector<HTMLButtonElement>(".agillex-faq__trigger");
            const otherAnswer = other.querySelector<HTMLElement>(".agillex-faq__answer");
            if (otherTrigger && otherAnswer) {
              otherTrigger.setAttribute("aria-expanded", "false");
              other.classList.remove("agillex-faq__item--open");
              otherAnswer.hidden = true;
            }
          }
        });

        // Alterna o atual
        if (isExpanded) {
          trigger.setAttribute("aria-expanded", "false");
          item.classList.remove("agillex-faq__item--open");
          answer.hidden = true;
        } else {
          trigger.setAttribute("aria-expanded", "true");
          item.classList.add("agillex-faq__item--open");
          answer.hidden = false;
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
