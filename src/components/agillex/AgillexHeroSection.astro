---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexContent } from "../../content/agillex";
import "./agillex-hero-section.css";
---

<Section id="hero-agillex" spacing="lg">
  <Container>
    <div class="agillex-hero">
      <div class="agillex-hero__badge">
        <span>{agillexContent.hero.badge}</span>
      </div>
      <h1 class="agillex-hero__title">
        {agillexContent.hero.title}
      </h1>
      <p class="agillex-hero__description">
        {agillexContent.hero.description}
      </p>

      <div class="agillex-hero__actions">
        <a
          href={agillexContent.hero.actions.primary.href}
          class="agillex-hero__btn agillex-hero__btn--primary"
          target={agillexContent.hero.actions.primary.target ?? "_blank"}
          rel={agillexContent.hero.actions.primary.rel ?? "noopener noreferrer"}
        >
          {agillexContent.hero.actions.primary.label}
        </a>
        {agillexContent.hero.actions.demo && (
          <a
            href={agillexContent.hero.actions.demo.href}
            class="agillex-hero__btn agillex-hero__btn--demo"
            target={agillexContent.hero.actions.demo.target}
            rel={agillexContent.hero.actions.demo.rel}
          >
            <span class="agillex-hero__btn-icon" aria-hidden="true">💈</span>
            <span>{agillexContent.hero.actions.demo.label}</span>
          </a>
        )}
        <a
          href={agillexContent.hero.actions.secondary.href}
          class="agillex-hero__btn agillex-hero__btn--secondary"
          target={agillexContent.hero.actions.secondary.target}
          rel={agillexContent.hero.actions.secondary.rel}
        >
          {agillexContent.hero.actions.secondary.label}
        </a>
      </div>

      <div class="agillex-hero__trust">
        <svg
          class="agillex-hero__trust-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
        <span>{agillexContent.hero.trust}</span>
      </div>

      <!-- Preview Visual Dinâmico do Hero -->
      <div class="agillex-hero__preview">
        <div class="agillex-hero__window">
          <div class="agillex-hero__window-bar">
            <div class="agillex-hero__window-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="agillex-hero__window-url">
              agenda.alllogiconline.com.br/agillex
            </div>
            <span class="agillex-hero__window-status">● Sistema Ativo 24/7</span>
          </div>

          <div class="agillex-hero__window-content">
            <div class="agillex-hero__preview-grid">
              <div class="agillex-hero__slot agillex-hero__slot--confirmed">
                <span class="agillex-hero__slot-time">09:00 - 09:45</span>
                <strong>Corte Clássico & Barba</strong>
                <span class="agillex-hero__slot-status">✓ Confirmado via WhatsApp</span>
              </div>
              <div class="agillex-hero__slot agillex-hero__slot--confirmed">
                <span class="agillex-hero__slot-time">10:30 - 11:15</span>
                <strong>Atendimento Agendado</strong>
                <span class="agillex-hero__slot-status">✓ Confirmado via WhatsApp</span>
              </div>
              <div class="agillex-hero__slot agillex-hero__slot--open">
                <span class="agillex-hero__slot-time">14:00 - 15:00</span>
                <strong>Horário Disponível</strong>
                <span class="agillex-hero__slot-status">Agendamento online 24/7</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>
