---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexGedContent } from "../../content/agillex-ged";
import "../agillex/agillex-trial-section.css";
---

<Section id="teste-gratis" background="default" spacing="lg">
  <Container>
    <div class="agillex-trial">
      <div class="agillex-trial__content" data-scroll-reveal="left">
        <span class="agillex-trial__eyebrow">{agillexGedContent.trial.eyebrow}</span>
        <h2 class="agillex-trial__title">{agillexGedContent.trial.title}</h2>
        <p class="agillex-trial__description">{agillexGedContent.trial.description}</p>

        <ul class="agillex-trial__points">
          {agillexGedContent.trial.points.map((point) => (
            <li class="agillex-trial__point">
              <strong>{point.label}:</strong> {point.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="agillex-trial__card card-interactive" data-scroll-reveal="right">
        <span class="agillex-trial__card-highlight">{agillexGedContent.trial.card.highlight}</span>
        <h3 class="agillex-trial__card-title">{agillexGedContent.trial.card.title}</h3>
        <p class="agillex-trial__card-description">{agillexGedContent.trial.card.description}</p>
        <a
          href={agillexGedContent.trial.card.action.href}
          class="agillex-trial__card-btn"
          target={agillexGedContent.trial.card.action.target ?? "_blank"}
          rel={agillexGedContent.trial.card.action.rel ?? "noopener noreferrer"}
        >
          {agillexGedContent.trial.card.action.label}
        </a>
        <p class="agillex-trial__card-note">{agillexGedContent.trial.card.note}</p>
      </div>
    </div>
  </Container>
</Section>
