---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexGedContent } from "../../content/agillex-ged";
import "../agillex/agillex-audience-section.css";
---

<Section id="publico-alvo" background="light" spacing="lg">
  <Container size="xl">
    <div class="agillex-audience__header" data-scroll-reveal="left">
      <span class="agillex-audience__eyebrow">{agillexGedContent.audience.eyebrow}</span>
      <h2 class="agillex-audience__title">{agillexGedContent.audience.title}</h2>
      {agillexGedContent.audience.complement && (
        <p class="agillex-audience__complement">
          {agillexGedContent.audience.complement}
        </p>
      )}
      <p class="agillex-audience__description">
        {agillexGedContent.audience.description}
      </p>
    </div>

    <div class="agillex-audience__grid">
      {agillexGedContent.audience.items.map((item, index) => (
        <div
          class="agillex-audience__card card-interactive"
          data-scroll-reveal={index % 2 === 0 ? "left" : "right"}
        >
          <div class="agillex-audience__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="agillex-audience__card-title">{item.title}</h3>
          <p class="agillex-audience__card-description">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
