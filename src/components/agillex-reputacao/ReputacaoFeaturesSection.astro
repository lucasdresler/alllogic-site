---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexReputacaoContent } from "../../content/agillex-reputacao";
import "../agillex/agillex-features-section.css";
---

<Section id="recursos" background="default" spacing="lg">
  <Container size="xl">
    <div class="agillex-features__header" data-scroll-reveal="up">
      <span class="agillex-features__eyebrow">{agillexReputacaoContent.features.eyebrow}</span>
      <h2 class="agillex-features__title">{agillexReputacaoContent.features.title}</h2>
      <p class="agillex-features__description">
        {agillexReputacaoContent.features.description}
      </p>
    </div>

    <div class="agillex-features__grid">
      {agillexReputacaoContent.features.items.map((item) => (
        <div class="agillex-features__card card-interactive" data-scroll-reveal="up">
          <div class="agillex-features__badge">{item.badge}</div>
          <h3 class="agillex-features__card-title">{item.title}</h3>
          <p class="agillex-features__card-description">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
