---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexReputacaoContent } from "../../content/agillex-reputacao";
import "../agillex/agillex-audience-section.css";
---

<Section id="publico-alvo" background="light" spacing="lg">
  <Container size="xl">
    <div class="agillex-audience__header" data-scroll-reveal="up">
      <span class="agillex-audience__eyebrow">{agillexReputacaoContent.audience.eyebrow}</span>
      <h2 class="agillex-audience__title">{agillexReputacaoContent.audience.title}</h2>
      {agillexReputacaoContent.audience.complement && (
        <p class="agillex-audience__complement">
          {agillexReputacaoContent.audience.complement}
        </p>
      )}
      <p class="agillex-audience__description">
        {agillexReputacaoContent.audience.description}
      </p>
    </div>

    <div class="agillex-audience__grid">
      {agillexReputacaoContent.audience.items.map((item) => (
        <div class="agillex-audience__card card-interactive" data-scroll-reveal="up">
          <div class="agillex-audience__icon" aria-hidden="true">{item.icon}</div>
          <h3 class="agillex-audience__card-title">{item.title}</h3>
          <p class="agillex-audience__card-description">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
