<script>
  function initHubStickyShowcase(): void {
    const stepCards = Array.from(document.querySelectorAll<HTMLElement>(".hub-step-card"));
    const screenViews = Array.from(document.querySelectorAll<HTMLElement>(".hub-screen-view"));
    const windowTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hub-window-tab"));
    const liveStatusLabel = document.getElementById("hub-live-status-label");

    if (stepCards.length === 0 || screenViews.length === 0) return;

    const moduleStatusNames = [
      "IA WhatsApp Conectado",
      "Agenda Sincronizada",
      "CRM Kanban Ativo",
      "Pay Taxa R$ 1,99 Ativo",
      "Multi-Tenant Matriz/Filiais"
    ];

    let currentActiveIdx = 0;

    function activateModule(index: number, shouldScroll = false): void {
      if (index === currentActiveIdx && !shouldScroll) return;
      currentActiveIdx = index;

      // Atualiza os cards da esquerda
      stepCards.forEach((card, idx) => {
        if (idx === index) {
          card.classList.add("is-active");
        } else {
          card.classList.remove("is-active");
        }
      });

      // Atualiza as telas da janela fixa
      screenViews.forEach((view, idx) => {
        if (idx === index) {
          view.classList.add("is-active");
        } else {
          view.classList.remove("is-active");
        }
      });

      // Atualiza as abas da janela
      windowTabs.forEach((tab, idx) => {
        if (idx === index) {
          tab.classList.add("is-active");
        } else {
          tab.classList.remove("is-active");
        }
      });

      // Atualiza o texto de status
      if (liveStatusLabel && moduleStatusNames[index]) {
        liveStatusLabel.textContent = moduleStatusNames[index];
      }

      // Se solicitado, rola suavemente até o card correspondente
      if (shouldScroll && stepCards[index]) {
        stepCards[index].scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    // Clique nos cards da esquerda ativa a tela correspondente
    stepCards.forEach((card) => {
      card.addEventListener("click", () => {
        const idx = Number(card.getAttribute("data-step-index"));
        if (!isNaN(idx)) {
          activateModule(idx, false);
        }
      });

      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const idx = Number(card.getAttribute("data-step-index"));
          if (!isNaN(idx)) {
            activateModule(idx, true);
          }
        }
      });
    });

    // Clique nas abas superiores da janela ativa a tela e rola até o passo
    windowTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetIdx = Number(tab.getAttribute("data-switch-to"));
        if (!isNaN(targetIdx)) {
          activateModule(targetIdx, true);
        }
      });
    });

    // IntersectionObserver para detectar qual card está no centro da tela ao rolar
    if ("IntersectionObserver" in window) {
      const observerOptions: IntersectionObserverInit = {
        root: null,
        // Detecta quando o card cruza o terço central da tela
        rootMargin: "-25% 0px -40% 0px",
        threshold: 0.15,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Number(entry.target.getAttribute("data-step-index"));
            if (!isNaN(idx)) {
              activateModule(idx, false);
            }
          }
        });
      }, observerOptions);

      stepCards.forEach((card) => observer.observe(card));
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHubStickyShowcase);
  } else {
    initHubStickyShowcase();
  }
</script>
