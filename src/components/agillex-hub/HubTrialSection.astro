---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexHubContent } from "../../content/agillex-hub";
import "../agillex/agillex-trial-section.css";

const { trial } = agillexHubContent;
---

<Section id="teste-gratuito" background="light" spacing="lg">
  <Container>
    <div class="agillex-trial">
      <div class="agillex-trial__content" data-scroll-reveal="up">
        <span class="agillex-trial__eyebrow">{trial.eyebrow}</span>
        <h2 class="agillex-trial__title">{trial.title}</h2>
        <p class="agillex-trial__description">
          {trial.description}
        </p>
        <ul class="agillex-trial__list">
          {trial.points.map((point) => (
            <li class="agillex-trial__list-item">
              <strong>{point.label}:</strong> {point.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="agillex-trial__cta" data-scroll-reveal="up">
        <div class="agillex-trial__card card-interactive-glow">
          <span class="agillex-trial__highlight">{trial.card.highlight}</span>
          <h3 class="agillex-trial__card-title">{trial.card.title}</h3>
          <p class="agillex-trial__card-description">{trial.card.description}</p>
          <a
            href={trial.card.action.href}
            class="agillex-trial__btn btn-interactive"
            target={trial.card.action.target ?? "_blank"}
            rel={trial.card.action.rel ?? "noopener noreferrer"}
          >
            {trial.card.action.label}
          </a>
          {trial.card.note && (
            <span class="agillex-trial__note">{trial.card.note}</span>
          )}
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .agillex-trial__eyebrow {
    color: var(--color-accent, #c9a227) !important;
    font-weight: 700;
  }

  .agillex-trial__highlight {
    background: rgba(201, 162, 39, 0.15) !important;
    color: var(--color-accent, #c9a227) !important;
    border: 1px solid rgba(201, 162, 39, 0.35) !important;
  }

  .agillex-trial__btn {
    background: linear-gradient(135deg, #c9a227 0%, #e0bc46 100%) !important;
    color: #061530 !important;
    font-weight: 800 !important;
    box-shadow: 0 4px 14px rgba(201, 162, 39, 0.35) !important;
  }

  .agillex-trial__btn:hover {
    background: linear-gradient(135deg, #dfb83b 0%, #ecd067 100%) !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.45) !important;
  }
</style>
