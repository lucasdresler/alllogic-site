---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexCobrancaContent } from "../../content/agillex-cobranca";
import "../agillex/agillex-faq-section.css";

const { faq } = agillexCobrancaContent;
---

<Section id="duvidas-frequentes" background="default" spacing="lg">
  <Container>
    <div class="agillex-faq" data-scroll-reveal="up">
      <div class="agillex-faq__header">
        <span class="agillex-faq__eyebrow">{faq.eyebrow}</span>
        <h2 class="agillex-faq__title">{faq.title}</h2>
        <p class="agillex-faq__description">{faq.description}</p>
      </div>

      <div class="agillex-faq__accordion">
        {
          faq.items.map((item, idx) => (
            <div class="agillex-faq__item" data-faq-item>
              <button
                type="button"
                class="agillex-faq__trigger"
                aria-expanded="false"
                aria-controls={`cobranca-faq-answer-${idx}`}
                id={`cobranca-faq-trigger-${idx}`}
              >
                <span class="agillex-faq__question-text">{item.question}</span>
                <span class="agillex-faq__icon" aria-hidden="true">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </span>
              </button>
              <div
                class="agillex-faq__answer"
                id={`cobranca-faq-answer-${idx}`}
                role="region"
                aria-labelledby={`cobranca-faq-trigger-${idx}`}
                hidden
              >
                <p class="agillex-faq__answer-text">{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<script>
  function initCobrancaFaq() {
    const items = document.querySelectorAll("#duvidas-frequentes [data-faq-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".agillex-faq__trigger");
      const answer = item.querySelector<HTMLDivElement>(".agillex-faq__answer");

      if (!trigger || !answer || trigger.dataset.bound === "true") return;
      trigger.dataset.bound = "true";

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        // Fechar outros itens
        items.forEach((other) => {
          if (other !== item) {
            const otherTrigger = other.querySelector<HTMLButtonElement>(".agillex-faq__trigger");
            const otherAnswer = other.querySelector<HTMLDivElement>(".agillex-faq__answer");
            otherTrigger?.setAttribute("aria-expanded", "false");
            if (otherAnswer) otherAnswer.hidden = true;
          }
        });

        trigger.setAttribute("aria-expanded", String(!isExpanded));
        answer.hidden = isExpanded;
      });
    });
  }

  initCobrancaFaq();
  document.addEventListener("astro:page-load", initCobrancaFaq);
</script>
