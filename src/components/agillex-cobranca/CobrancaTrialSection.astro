---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexCobrancaContent } from "../../content/agillex-cobranca";
import "../agillex/agillex-trial-section.css";
---

<Section id="teste-gratuito" background="light" spacing="lg">
  <Container>
    <div class="agillex-trial">
      <div class="agillex-trial__content" data-scroll-reveal="up">
        <span class="agillex-trial__eyebrow">{agillexCobrancaContent.trial.eyebrow}</span>
        <h2 class="agillex-trial__title">{agillexCobrancaContent.trial.title}</h2>
        <p class="agillex-trial__description">
          {agillexCobrancaContent.trial.description}
        </p>
        <ul class="agillex-trial__list">
          {agillexCobrancaContent.trial.points.map((point) => (
            <li class="agillex-trial__list-item">
              <strong>{point.label}:</strong> {point.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="agillex-trial__cta" data-scroll-reveal="up">
        <div class="agillex-trial__card">
          <span class="agillex-trial__highlight">{agillexCobrancaContent.trial.card.highlight}</span>
          <h3 class="agillex-trial__card-title">{agillexCobrancaContent.trial.card.title}</h3>
          <p class="agillex-trial__card-description">{agillexCobrancaContent.trial.card.description}</p>
          <a
            href={agillexCobrancaContent.trial.card.action.href}
            class="agillex-trial__btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            {agillexCobrancaContent.trial.card.action.label}
          </a>
          {agillexCobrancaContent.trial.card.note && (
            <span class="agillex-trial__note">{agillexCobrancaContent.trial.card.note}</span>
          )}
        </div>
      </div>
    </div>
  </Container>
</Section>
