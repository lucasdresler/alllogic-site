---
import "./cookie-consent.css";
---

<div class="cookie-consent" data-cookie-consent hidden>
  <div class="cookie-consent__content">
    <div class="cookie-consent__text">
      <p class="cookie-consent__title">Privacidade e cookies</p>
      <p>
        Utilizamos cookies de análise para entender como o site é utilizado
        e melhorar sua experiência. Você pode aceitar ou recusar esses cookies.
        <a href="/politica-de-privacidade">Saiba mais na Política de Privacidade.</a>
      </p>
    </div>

    <div class="cookie-consent__actions">
      <button type="button" data-cookie-consent-reject>
        Recusar
      </button>
      <button type="button" data-cookie-consent-accept>
        Aceitar
      </button>
    </div>
  </div>
</div>

<button
  type="button"
  class="cookie-consent__manage"
  data-cookie-consent-manage
  hidden
>
  Preferências de privacidade
</button>

<script>
  import { loadAnalytics } from "../../lib/analytics";

  const consentKey = "alllogic-cookie-consent";
  const consentElement = document.querySelector<HTMLElement>(
    "[data-cookie-consent]"
  );
  const manageElement = document.querySelector<HTMLButtonElement>(
    "[data-cookie-consent-manage]"
  );

  const manageVisibilityDuration = 60_000;

  function updateManageVisibility(): void {
    if (manageElement) {
      manageElement.hidden = !localStorage.getItem(consentKey);
    }
  }

  function scheduleManageHide(): void {
    if (manageElement) {
      window.setTimeout(() => {
        manageElement.hidden = true;
      }, manageVisibilityDuration);
    }
  }

  function showConsent(): void {
    if (consentElement) {
      consentElement.hidden = false;
    }
  }

  if (consentElement) {
    const savedConsent = localStorage.getItem(consentKey);

    if (savedConsent === "accepted") {
      loadAnalytics();
    } else if (!savedConsent) {
      showConsent();
    }

    consentElement
      .querySelector("[data-cookie-consent-accept]")
      ?.addEventListener("click", () => {
        localStorage.setItem(consentKey, "accepted");
        consentElement.hidden = true;
        updateManageVisibility();
        scheduleManageHide();
        loadAnalytics();
      });

    consentElement
      .querySelector("[data-cookie-consent-reject]")
      ?.addEventListener("click", () => {
        localStorage.setItem(consentKey, "rejected");
        consentElement.hidden = true;
        updateManageVisibility();
        scheduleManageHide();
      });
  }

  manageElement?.addEventListener("click", () => {
    localStorage.removeItem(consentKey);
    showConsent();
    updateManageVisibility();
  });

  updateManageVisibility();

  if (manageElement && !manageElement.hidden) {
    scheduleManageHide();
  }
</script>
