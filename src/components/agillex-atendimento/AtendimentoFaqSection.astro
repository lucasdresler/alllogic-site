---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { agillexAtendimentoContent } from "../../content/agillex-atendimento";
import "../agillex/agillex-faq-section.css";

const { faq } = agillexAtendimentoContent;
---

<Section id="duvidas-frequentes" background="default" spacing="lg">
  <Container>
    <div class="agillex-faq" data-scroll-reveal="up">
      <div class="agillex-faq__header">
        <span class="agillex-faq__eyebrow">{faq.eyebrow}</span>
        <h2 class="agillex-faq__title">{faq.title}</h2>
        <p class="agillex-faq__description">{faq.description}</p>
      </div>

      <div class="agillex-faq__accordion">
        {
          faq.items.map((item, idx) => (
            <div class="agillex-faq__item" data-faq-item>
              <button
                type="button"
                class="agillex-faq__trigger"
                aria-expanded="false"
                aria-controls={`atend-faq-answer-${idx}`}
                id={`atend-faq-trigger-${idx}`}
              >
                <span class="agillex-faq__question-text">{item.question}</span>
                <span class="agillex-faq__icon" aria-hidden="true">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </span>
              </button>
              <div
                class="agillex-faq__answer"
                id={`atend-faq-answer-${idx}`}
                role="region"
                aria-labelledby={`atend-faq-trigger-${idx}`}
                hidden
              >
                <p class="agillex-faq__answer-text">{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<script>
  function initAtendimentoFaq(): void {
    const faqTriggers = document.querySelectorAll<HTMLButtonElement>(
      "#duvidas-frequentes .agillex-faq__trigger"
    );

    faqTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        const answerId = trigger.getAttribute("aria-controls");
        if (!answerId) return;

        const answer = document.getElementById(answerId);
        if (!answer) return;

        faqTriggers.forEach((otherTrigger) => {
          if (otherTrigger !== trigger) {
            otherTrigger.setAttribute("aria-expanded", "false");
            const otherAnswerId = otherTrigger.getAttribute("aria-controls");
            if (otherAnswerId) {
              const otherAnswer = document.getElementById(otherAnswerId);
              if (otherAnswer) otherAnswer.hidden = true;
            }
          }
        });

        trigger.setAttribute("aria-expanded", (!isExpanded).toString());
        answer.hidden = isExpanded;
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAtendimentoFaq);
  } else {
    initAtendimentoFaq();
  }
</script>
