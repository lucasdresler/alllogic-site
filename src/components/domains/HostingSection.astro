---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./hosting-section.css";
---

<Section id="hospedagem-sites" spacing="lg">
  <Container>
    <div class="hosting-section__content">
      <p class="hosting-section__eyebrow">Hospedagem de Sites</p>
      <h2>Uma estrutura para manter seu site online.</h2>
      <p class="hosting-section__description">
        Hospedagem para sites e lojas online, integrada às necessidades da
        presença digital da sua empresa.
      </p>
    </div>
  </Container>
</Section>
