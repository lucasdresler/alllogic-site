---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./hosting-section.css";

const plans = [
  {
    name: "Essencial",
    description: "Para empresas que estão começando sua presença digital.",
    sites: 1,
    storage: "5 GB",
    bandwidth: "50 GB/mês",
    emails: 5,
    databases: 2,
    ftp: 1,
    subdomains: 5,
    additionalDomains: 0,
    domainBenefit: "Assistência e DNS inclusos",
    ssl: "Grátis e Automático",
  },
  {
    name: "Profissional",
    description: "Para empresas que já precisam de uma estrutura profissional.",
    sites: 2,
    storage: "10 GB",
    bandwidth: "100 GB/mês",
    emails: 10,
    databases: 5,
    ftp: 2,
    subdomains: 10,
    additionalDomains: 1,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
  {
    name: "Avançado",
    description: "Para empresas em crescimento e operações maiores.",
    sites: 5,
    storage: "25 GB",
    bandwidth: "150 GB/mês",
    emails: 20,
    databases: 10,
    ftp: 3,
    subdomains: 20,
    additionalDomains: 4,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
  {
    name: "Empresarial",
    description: "Para empresas que precisam de uma estrutura mais robusta.",
    sites: 10,
    storage: "50 GB",
    bandwidth: "200 GB/mês",
    emails: 30,
    databases: 15,
    ftp: 5,
    subdomains: 30,
    additionalDomains: 9,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
];

const items = [
  "Sites",
  "Armazenamento",
  "Tráfego",
  "Contas de e-mail",
  "Bancos de dados",
  "Contas FTP",
  "Subdomínios",
  "Domínios adicionais",
  "Gestão Técnica & DNS",
  "Certificado SSL",
];
---

<Section id="hospedagem-sites" spacing="lg">
  <div id="hospedagem" style="scroll-margin-top: 110px;"></div>
  <Container>
    <div class="hosting-section__content">
      <p class="hosting-section__eyebrow">Hospedagem de Sites</p>
      <h2>Uma estrutura para manter sua empresa online.</h2>
      <p class="hosting-section__description">
        Hospedagem para sites e lojas online, com alta performance, gestão técnica de DNS, ativação de certificados SSL e suporte especializado AllLogic Online.
      </p>
    </div>

    <!-- Banner dinâmico exibido quando um domínio é selecionado na busca -->
    <div id="hosting-domain-banner" class="hosting-domain-banner" style="display: none;">
      <div class="hosting-domain-banner__icon">🌐</div>
      <div class="hosting-domain-banner__body">
        <div class="hosting-domain-banner__title">
          Domínio selecionado para ativação: <strong id="hosting-selected-domain-name"></strong>
        </div>
        <div class="hosting-domain-banner__subtitle">
          Assessoria completa da AllLogic: registro oficial no seu CPF/CNPJ, apontamento e gestão de DNS e SSL inclusos.
        </div>
      </div>
      <button type="button" id="hosting-clear-domain-btn" class="hosting-domain-banner__clear" title="Consultar ou alterar domínio">
        Alterar domínio
      </button>
    </div>

    <div class="hosting-section__comparison">
      <div class="hosting-section__labels">
        <div class="hosting-section__labels-header">
          <h3>Recursos</h3>
          <p>Confira os limites incluídos em cada plano.</p>
        </div>
        {
          items.map((item) => (
            <div class="hosting-section__label">{item}</div>
          ))
        }
        <div class="hosting-section__labels-action">
          <span>Contratação</span>
        </div>
      </div>

      {
        plans.map((plan) => (
          <article class="hosting-section__card">
            <div class="hosting-section__card-header">
              <h3>{plan.name}</h3>
              <p>{plan.description}</p>
            </div>

            <div class="hosting-section__values">
              <div>{plan.sites}</div>
              <div>{plan.storage}</div>
              <div>{plan.bandwidth}</div>
              <div>{plan.emails}</div>
              <div>{plan.databases}</div>
              <div>{plan.ftp}</div>
              <div>{plan.subdomains}</div>
              <div>{plan.additionalDomains}</div>
              <div style="font-size: 0.825rem;">{plan.domainBenefit}</div>
              <div style="font-size: 0.825rem; color: var(--color-success); font-weight: 700;">{plan.ssl}</div>
            </div>

            <div class="hosting-section__card-action">
              <a
                href={`https://wa.me/5511966381915?text=${encodeURIComponent(`Olá! Gostaria de saber mais e contratar o plano de Hospedagem ${plan.name} da AllLogic Online.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="hosting-card__btn js-hosting-plan-btn"
                data-plan={plan.name}
              >
                Contratar Plano
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>

<script>
  function initHostingDomainContext(): void {
    const banner = document.getElementById("hosting-domain-banner");
    const domainNameEl = document.getElementById("hosting-selected-domain-name");
    const clearBtn = document.getElementById("hosting-clear-domain-btn");
    const planBtns = document.querySelectorAll<HTMLAnchorElement>(".js-hosting-plan-btn");

    function updateContext(domain: string | null): void {
      if (!banner || !domainNameEl) return;

      if (domain && domain.trim() !== "") {
        domainNameEl.textContent = domain;
        banner.style.display = "flex";

        planBtns.forEach((btn) => {
          const planName = btn.getAttribute("data-plan") || "Hospedagem";
          const msg = `Olá! Gostaria de contratar a Hospedagem AllLogic (Plano ${planName}) para o domínio ${domain} com registro e assessoria técnica de DNS inclusos.`;
          btn.href = `https://wa.me/5511966381915?text=${encodeURIComponent(msg)}`;
        });
      } else {
        banner.style.display = "none";
        planBtns.forEach((btn) => {
          const planName = btn.getAttribute("data-plan") || "Hospedagem";
          const msg = `Olá! Gostaria de saber mais e contratar o plano de Hospedagem ${planName} da AllLogic Online.`;
          btn.href = `https://wa.me/5511966381915?text=${encodeURIComponent(msg)}`;
        });
      }
    }

    const currentDomain = window.sessionStorage.getItem("selectedDomain");
    updateContext(currentDomain);

    window.addEventListener("domainSelected", ((e: CustomEvent) => {
      const selected = e.detail?.domain || window.sessionStorage.getItem("selectedDomain");
      updateContext(selected);
    }) as EventListener);

    clearBtn?.addEventListener("click", () => {
      window.sessionStorage.removeItem("selectedDomain");
      updateContext(null);
      const searchSection = document.getElementById("busca-dominio");
      searchSection?.scrollIntoView({ behavior: "smooth" });
      const searchInput = document.getElementById("domain-search-input") as HTMLInputElement | null;
      searchInput?.focus();
    });
  }

  initHostingDomainContext();
  document.addEventListener("astro:page-load", initHostingDomainContext);
</script>
