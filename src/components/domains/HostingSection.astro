---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./hosting-section.css";

const plans = [
  {
    id: "essencial",
    name: "Essencial",
    description: "Para empresas que estão começando sua presença digital.",
    popular: false,
    priceMonthly: "29,90",
    priceYearly: "23,90",
    sites: 1,
    storage: "5 GB",
    bandwidth: "50 GB/mês",
    emails: 5,
    databases: 2,
    ftp: 1,
    subdomains: 5,
    additionalDomains: 0,
    domainBenefit: "Assistência e DNS inclusos",
    ssl: "Grátis e Automático",
  },
  {
    id: "profissional",
    name: "Profissional",
    description: "Para empresas que já precisam de uma estrutura profissional.",
    popular: true,
    priceMonthly: "49,90",
    priceYearly: "39,90",
    sites: 2,
    storage: "10 GB",
    bandwidth: "100 GB/mês",
    emails: 10,
    databases: 5,
    ftp: 2,
    subdomains: 10,
    additionalDomains: 1,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
  {
    id: "avancado",
    name: "Avançado",
    description: "Para empresas em crescimento e operações maiores.",
    popular: false,
    priceMonthly: "89,90",
    priceYearly: "69,90",
    sites: 5,
    storage: "25 GB",
    bandwidth: "150 GB/mês",
    emails: 20,
    databases: 10,
    ftp: 3,
    subdomains: 20,
    additionalDomains: 4,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
  {
    id: "empresarial",
    name: "Empresarial",
    description: "Para empresas que precisam de uma estrutura mais robusta.",
    popular: false,
    priceMonthly: "149,90",
    priceYearly: "119,90",
    sites: 10,
    storage: "50 GB",
    bandwidth: "200 GB/mês",
    emails: 30,
    databases: 15,
    ftp: 5,
    subdomains: 30,
    additionalDomains: 9,
    domainBenefit: "1º ano grátis no anual",
    ssl: "Grátis e Automático",
  },
];

const items = [
  "Sites",
  "Armazenamento",
  "Tráfego",
  "Contas de e-mail",
  "Bancos de dados",
  "Contas FTP",
  "Subdomínios",
  "Domínios adicionais",
  "Gestão Técnica & DNS",
  "Certificado SSL",
];
---

<Section id="hospedagem-sites" spacing="lg">
  <div id="hospedagem" style="scroll-margin-top: 110px;"></div>
  <Container>
    <div class="hosting-section__content">
      <p class="hosting-section__eyebrow">Hospedagem de Sites</p>
      <h2>Uma estrutura para manter sua empresa online.</h2>
      <p class="hosting-section__description">
        Hospedagem para sites e lojas online, com alta performance, gestão técnica de DNS, ativação de certificados SSL e suporte especializado AllLogic Online.
      </p>

      <!-- Seletor de Ciclos de Faturamento -->
      <div class="hosting-cycle-bar">
        <div class="hosting-cycle-selector" role="radiogroup" aria-label="Ciclo de Faturamento">
          <button type="button" class="hosting-cycle-btn is-active" data-cycle="monthly">
            Mensal
          </button>
          <button type="button" class="hosting-cycle-btn" data-cycle="yearly">
            <span>Anual</span>
            <span class="hosting-cycle-badge">20% OFF</span>
          </button>
        </div>
        <div class="hosting-cycle-note">
          <span class="hosting-cycle-note-icon">🎁</span>
          <span>No plano anual: <strong>1º ano do domínio .com.br grátis</strong></span>
        </div>
      </div>
    </div>

    <!-- Banner dinâmico exibido quando um domínio é selecionado na busca -->
    <div id="hosting-domain-banner" class="hosting-domain-banner" style="display: none;">
      <div class="hosting-domain-banner__icon">🌐</div>
      <div class="hosting-domain-banner__body">
        <div class="hosting-domain-banner__title">
          Domínio selecionado para ativação: <strong id="hosting-selected-domain-name"></strong>
        </div>
        <div class="hosting-domain-banner__subtitle">
          Assessoria completa da AllLogic: registro oficial no seu CPF/CNPJ, apontamento e gestão de DNS e SSL inclusos.
        </div>
      </div>
      <button type="button" id="hosting-clear-domain-btn" class="hosting-domain-banner__clear" title="Consultar ou alterar domínio">
        Alterar domínio
      </button>
    </div>

    <div class="hosting-section__comparison">
      <div class="hosting-section__labels">
        <div class="hosting-section__labels-header">
          <h3>Recursos</h3>
          <p>Estrutura cPanel com isolamento CloudLinux.</p>
          <div class="hosting-labels-price-placeholder">
            <span>Investimento</span>
          </div>
        </div>
        {
          items.map((item) => (
            <div class="hosting-section__label">{item}</div>
          ))
        }
        <div class="hosting-section__labels-action">
          <span>Contratação</span>
        </div>
      </div>

      {
        plans.map((plan) => (
          <article class={`hosting-section__card ${plan.popular ? 'hosting-section__card--popular' : ''}`}>
            <div class="hosting-section__card-header">
              <div class="hosting-card-title-wrap">
                <h3 class="hosting-card-title">{plan.name}</h3>
                {plan.popular && <span class="hosting-popular-badge">Mais Escolhido</span>}
              </div>
              <p class="hosting-card-desc">{plan.description}</p>

              <div class="hosting-card-price-area">
                <div class="hosting-card-price">
                  <span class="hosting-card-currency">R$</span>
                  <span
                    class="hosting-card-amount js-hosting-price"
                    data-monthly={plan.priceMonthly}
                    data-yearly={plan.priceYearly}
                  >
                    {plan.priceMonthly}
                  </span>
                  <span class="hosting-card-period js-hosting-period">/mês</span>
                </div>
                <span class="hosting-card-cycle-note js-hosting-subnote">no plano mensal</span>
              </div>
            </div>

            <div class="hosting-section__values">
              <div>{plan.sites}</div>
              <div>{plan.storage}</div>
              <div>{plan.bandwidth}</div>
              <div>{plan.emails}</div>
              <div>{plan.databases}</div>
              <div>{plan.ftp}</div>
              <div>{plan.subdomains}</div>
              <div>{plan.additionalDomains}</div>
              <div style="font-size: 0.825rem;">{plan.domainBenefit}</div>
              <div style="font-size: 0.825rem; color: var(--color-success); font-weight: 700;">{plan.ssl}</div>
            </div>

            <div class="hosting-section__card-action">
              <a
                href={`https://hub.alllogiconline.com.br/checkout?modulo=hospedagem&plano=${plan.id}&ciclo=monthly`}
                class="hosting-card__btn js-hosting-plan-btn"
                data-plan-id={plan.id}
                data-plan={plan.name}
              >
                Contratar Plano
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Garantia Incondicional de 7 Dias -->
    <div class="hosting-guarantee-card">
      <div class="hosting-guarantee-card__icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div class="hosting-guarantee-card__content">
        <h3 class="hosting-guarantee-card__title">Garantia Incondicional de 7 Dias (Risco Zero)</h3>
        <p class="hosting-guarantee-card__desc">
          Sua satisfação e tranquilidade em primeiro lugar. Teste nossa infraestrutura de hospedagem de alta performance sem compromisso. Se por qualquer motivo você decidir não continuar dentro dos primeiros 7 dias após a contratação, cancelamos o plano e <strong>devolvemos 100% do valor investido em sua hospedagem</strong>, sem burocracia ou questionamentos (conforme o Art. 49 do Código de Defesa do Consumidor).
        </p>
        <p class="hosting-guarantee-card__note">
          <strong>Regra de Transparência sobre Domínios:</strong> O reembolso de 100% aplica-se exclusivamente ao serviço de hospedagem. O registro do domínio (seja contratado à parte ou bonificado no plano anual) possui taxa pública irreversível perante os órgãos de registro (Registro.br/ICANN) e é registrado diretamente no seu CPF ou CNPJ. Por essa razão, o domínio não é reembolsável e permanecerá sob sua propriedade e titularidade exclusiva pelo período de 1 ano (sendo deduzido apenas o valor oficial de registro do domínio caso o cancelamento ocorra no plano anual com domínio incluso).
        </p>
      </div>
    </div>
  </Container>
</Section>

<script>
  function initHostingDomainContext(): void {
    const banner = document.getElementById("hosting-domain-banner");
    const domainNameEl = document.getElementById("hosting-selected-domain-name");
    const clearBtn = document.getElementById("hosting-clear-domain-btn");
    const planBtns = document.querySelectorAll<HTMLAnchorElement>(".js-hosting-plan-btn");
    const cycleBtns = document.querySelectorAll<HTMLButtonElement>(".hosting-cycle-btn");
    const priceEls = document.querySelectorAll<HTMLElement>(".js-hosting-price");
    const subnoteEls = document.querySelectorAll<HTMLElement>(".js-hosting-subnote");

    let currentCycle: "monthly" | "yearly" = "monthly";

    function updateContext(domain: string | null): void {
      if (banner && domainNameEl) {
        if (domain && domain.trim() !== "") {
          domainNameEl.textContent = domain;
          banner.style.display = "flex";
        } else {
          banner.style.display = "none";
        }
      }

      planBtns.forEach((btn) => {
        const planId = btn.getAttribute("data-plan-id") || "profissional";
        let checkoutUrl = `https://hub.alllogiconline.com.br/checkout?modulo=hospedagem&plano=${planId}&ciclo=${currentCycle}`;
        if (domain && domain.trim() !== "") {
          checkoutUrl += `&dominio=${encodeURIComponent(domain.trim())}`;
        }
        btn.href = checkoutUrl;
      });
    }

    function updateCycle(cycle: "monthly" | "yearly"): void {
      currentCycle = cycle;
      cycleBtns.forEach((btn) => {
        if (btn.getAttribute("data-cycle") === cycle) {
          btn.classList.add("is-active");
        } else {
          btn.classList.remove("is-active");
        }
      });

      priceEls.forEach((el) => {
        const val = cycle === "yearly" ? el.getAttribute("data-yearly") : el.getAttribute("data-monthly");
        if (val) el.textContent = val;
      });

      subnoteEls.forEach((el) => {
        el.textContent = cycle === "yearly" ? "cobrado anualmente (-20% OFF)" : "no plano mensal";
      });

      updateContext(window.sessionStorage.getItem("selectedDomain"));
    }

    cycleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cycle = (btn.getAttribute("data-cycle") as "monthly" | "yearly") || "monthly";
        updateCycle(cycle);
      });
    });

    const currentDomain = window.sessionStorage.getItem("selectedDomain");
    updateContext(currentDomain);

    window.addEventListener("domainSelected", ((e: CustomEvent) => {
      const selected = e.detail?.domain || window.sessionStorage.getItem("selectedDomain");
      updateContext(selected);
    }) as EventListener);

    clearBtn?.addEventListener("click", () => {
      window.sessionStorage.removeItem("selectedDomain");
      updateContext(null);
      const searchSection = document.getElementById("busca-dominio");
      searchSection?.scrollIntoView({ behavior: "smooth" });
      const searchInput = document.getElementById("domain-search-input") as HTMLInputElement | null;
      searchInput?.focus();
    });
  }

  initHostingDomainContext();
  document.addEventListener("astro:page-load", initHostingDomainContext);
</script>
