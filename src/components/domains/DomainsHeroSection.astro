---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./domains-hero-section.css";
---

<Section id="dominios-hospedagem-hero" spacing="lg">
  <Container>
    <div class="domains-hero-section__content">
      <p class="domains-hero-section__eyebrow">Domínios e Hospedagem</p>
      <h1>Registro de Domínios e Hospedagem de Sites de Alta Performance</h1>
      <p class="domains-hero-section__description">
        Tenha sua presença digital sob controle: registre seu domínio oficial e conte com infraestrutura cPanel com isolamento CloudLinux, DNS gerenciado e suporte especializado da AllLogic Online.
      </p>
    </div>
  </Container>
</Section>
