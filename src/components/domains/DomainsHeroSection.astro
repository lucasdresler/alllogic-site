---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./domains-hero-section.css";
---

<Section id="dominios-hospedagem-hero" spacing="lg">
  <Container>
    <div class="domains-hero-section__content">
      <p class="domains-hero-section__eyebrow">Domínios e Hospedagem</p>
      <h1>Tenha sua presença digital sob controle.</h1>
      <p class="domains-hero-section__description">
        Registre seu domínio e conte com hospedagem para manter seu site ou
        loja online funcionando com segurança e estrutura adequada.
      </p>
    </div>
  </Container>
</Section>
