---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import "./domains-hero-section.css";
---

<Section id="dominios-hospedagem-hero" spacing="lg">
  <Container>
    <div class="domains-hero-section__content" data-scroll-reveal="up">
      <p class="domains-hero-section__eyebrow">Domínios e Hospedagem</p>
      <h1>Registro de Domínios e Hospedagem de Sites de Alta Performance</h1>
      <p class="domains-hero-section__description">
        Tenha sua presença digital sob controle: registre seu domínio oficial e conte com infraestrutura cPanel com isolamento CloudLinux, DNS gerenciado e suporte especializado da <span class="brand-name"><span class="brand-name__all">All</span><span class="brand-name__logic">Logic</span> <span class="brand-name__online">Online</span></span>.
      </p>
    </div>
  </Container>
</Section>
