---
import Container from "../layout/Container.astro";
import { navigationContent } from "../../content/navigation";
import { siteContent } from "../../content/site";
import "./footer.css";
---

<footer class="footer">
  <Container>
    <div class="footer__inner">
      <!-- Marca -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="AllLogic">
          <img
            src="/images/logo-alllogic.png"
            alt="AllLogic — Engenharia de Soluções Digitais"
          />
        </a>
        <p>{siteContent.branding.tagline}</p>
      </div>

      <!-- Navegação institucional -->
      <div class="footer__nav">
        <h2>Navegação</h2>
        <nav aria-label="Navegação institucional">
          <ul>
            {navigationContent.footer.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Informações de contato -->
      <div class="footer__contact">
        <h2>Contato</h2>

        <address>
          <p>
            <span>E-mail</span>
            <a href={`mailto:${siteContent.contact.email}`}>
              {siteContent.contact.email}
            </a>
          </p>

          <p>
            <span>Telefone</span>
            <a href={`tel:+5511966381915`}>
              {siteContent.contact.phone}
            </a>
          </p>

          <p>
            <span>WhatsApp</span>
            <a
              href="https://wa.me/5511966381915"
              target="_blank"
              rel="noopener noreferrer"
            >
              {siteContent.contact.whatsapp}
            </a>
          </p>
        </address>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer__copyright">
      <p>
        © {new Date().getFullYear()} AllLogic. Todos os direitos reservados.
      </p>
    </div>
  </Container>
</footer>
