---
import Container from "../layout/Container.astro";
import Navigation from "./Navigation.astro";
import "./header.css";
---

<header class="header">
  <a class="header__services" href="/dominios-e-hospedagem">
    <span>Encontre seu domínio</span>
    <span>Hospede seu site</span>
  </a>

  <Container>
    <div class="header__inner">
      <div class="header__brand">
        <!-- Logo -->
        <a class="header__logo" href="/" aria-label="AllLogic Online">
          <img src="/images/logo-alllogic.png" alt="AllLogic Online" />
        </a>

        <!-- Botão hambúrguer no mobile -->
        <button
          type="button"
          class="navigation__toggle"
          id="navigation-toggle"
          aria-expanded="false"
          aria-controls="primary-navigation"
          aria-label="Abrir menu de navegação"
        >
          <span class="navigation__toggle-icon" aria-hidden="true">
            <span class="navigation__toggle-bar"></span>
            <span class="navigation__toggle-bar"></span>
            <span class="navigation__toggle-bar"></span>
          </span>
        </button>
      </div>

      <Navigation id="primary-navigation" />

      <!-- CTA será implementado futuramente -->
    </div>
  </Container>
</header>

<script>
  function initNavigation(): void {
    const toggleButton = document.getElementById(
      "navigation-toggle"
    ) as HTMLButtonElement | null;
    const navMenu = document.getElementById(
      "primary-navigation"
    ) as HTMLElement | null;

    if (!toggleButton || !navMenu) {
      return;
    }

    if (toggleButton.dataset.navInitialized === "true") {
      return;
    }
    toggleButton.dataset.navInitialized = "true";

    function openMenu(): void {
      toggleButton?.setAttribute("aria-expanded", "true");
      toggleButton?.setAttribute("aria-label", "Fechar menu de navegação");
      navMenu?.classList.add("is-open");
    }

    function closeMenu(): void {
      toggleButton?.setAttribute("aria-expanded", "false");
      toggleButton?.setAttribute("aria-label", "Abrir menu de navegação");
      navMenu?.classList.remove("is-open");
    }

    function toggleMenu(): void {
      const isExpanded = toggleButton?.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Abertura e fechamento pelo toque/clique no botão
    toggleButton.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Fechar o menu após a seleção de qualquer link
    const navLinks = navMenu.querySelectorAll<HTMLAnchorElement>("a");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Fechar com a tecla Escape e retornar o foco ao botão
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (
        e.key === "Escape" &&
        toggleButton.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
        toggleButton.focus();
      }
    });

    // Fechar ao clicar fora do painel de navegação e do botão (inclusive em outras áreas do cabeçalho)
    document.addEventListener("click", (e: MouseEvent) => {
      if (toggleButton.getAttribute("aria-expanded") !== "true") {
        return;
      }

      const target = e.target as Node | null;
      if (!target) {
        return;
      }

      const isInsideMenu = navMenu.contains(target);
      const isToggleButton = toggleButton.contains(target);

      if (!isInsideMenu && !isToggleButton) {
        closeMenu();
      }
    });

    // Resetar estado quando a viewport for redimensionada para desktop
    window.addEventListener("resize", () => {
      if (
        window.innerWidth > 768 &&
        toggleButton.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavigation);
  } else {
    initNavigation();
  }
</script>
