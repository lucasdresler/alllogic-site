---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { sobreContent } from "../../content/sobre";
import "./people-for-tech-section.css";
---

<Section id="tecnologia-para-pessoas" background="dark" spacing="lg">
  <Container>
    <div class="people-tech" data-scroll-reveal="up">
      <!-- Brilho ambiente decorativo -->
      <div class="people-tech__glow" aria-hidden="true"></div>

      <div class="people-tech__header">
        <span class="people-tech__badge">Propósito Institucional</span>
        <h2 class="people-tech__title">
          Tecnologia que trabalha <span class="people-tech__gold">para as pessoas.</span>
        </h2>
        <p class="people-tech__desc">{sobreContent.peopleForTech.description}</p>
      </div>

      <!-- Três destaques de impacto prático -->
      <div class="people-tech__grid">
        <div class="people-tech__item card-interactive">
          <span class="people-tech__icon" aria-hidden="true">⚡</span>
          <h3>Simplificação</h3>
          <p>Eliminar complexidade e tornar fluxos mais rápidos e transparentes.</p>
        </div>
        <div class="people-tech__item card-interactive">
          <span class="people-tech__icon" aria-hidden="true">⚙️</span>
          <h3>Automação com Cuidado</h3>
          <p>Reduzir esforço repetitivo sem desumanizar o atendimento e os relacionamentos.</p>
        </div>
        <div class="people-tech__item card-interactive">
          <span class="people-tech__icon" aria-hidden="true">🎯</span>
          <h3>Experiência Real</h3>
          <p>Criar soluções que realmente ajudam quem opera no dia a dia da empresa.</p>
        </div>
      </div>
    </div>
  </Container>
</Section>
