---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { sobreContent } from "../../content/sobre";
import "./about-closing-section.css";
---

<Section id="sobre-encerramento" background="light" spacing="lg">
  <Container>
    <div class="about-closing-card" data-scroll-reveal="up">
      <div class="about-closing-content">
        <span class="about-closing-eyebrow">Próximo Passo</span>
        <h2 class="about-closing-title">Vamos conversar sobre o seu cenário</h2>
        <p class="about-closing-desc">{sobreContent.closing.description}</p>
      </div>
      <div class="about-closing-actions">
        {sobreContent.closing.actions.map((action, idx) => (
          <a
            class={`about-closing-btn btn-interactive ${idx > 0 ? "about-closing-btn--secondary" : ""}`}
            href={action.href}
            target={action.href.startsWith("http") ? "_blank" : undefined}
            rel={action.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            <span>{action.label}</span>
            <span class="about-closing-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </Container>
</Section>
