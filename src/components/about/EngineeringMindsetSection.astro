---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { sobreContent } from "../../content/sobre";
import "./engineering-mindset-section.css";

const stepDescriptions: Record<string, string> = {
  "Entender": "Compreender o cenário e o problema real da empresa.",
  "Analisar": "Identificar causas, gargalos e oportunidades de melhoria.",
  "Planejar": "Definir a arquitetura da solução adequada ao contexto.",
  "Construir": "Implementar de forma organizada, sólida e sustentável.",
  "Testar": "Validar rigorosamente se atende aos objetivos de negócio.",
  "Evoluir": "Aprimorar a solução conforme novas necessidades surgem.",
};
---

<Section id="mentalidade-de-engenharia" spacing="lg">
  <Container>
    <div class="mindset-container">
      <div class="mindset-header" data-scroll-reveal="up">
        <span class="mindset-eyebrow">Método & Rigor Técnico</span>
        <h2 class="mindset-title">{sobreContent.engineeringMindset.title}</h2>
        <p class="mindset-desc">{sobreContent.engineeringMindset.description}</p>
      </div>

      <!-- Grid Interativo dos 6 Passos de Engenharia -->
      <div class="mindset-pipeline">
        {
          sobreContent.engineeringMindset.steps.map((step, index) => (
            <div class="mindset-step-card card-interactive" data-scroll-reveal="up">
              <div class="mindset-step-top">
                <span class="mindset-step-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="mindset-step-phase">Fase 0{index + 1}</span>
              </div>
              <h3 class="mindset-step-title">{step}</h3>
              <p class="mindset-step-desc">
                {stepDescriptions[step] ?? "Etapa estruturada de engenharia de soluções."}
              </p>
              <div class="mindset-step-line" aria-hidden="true"></div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</Section>
