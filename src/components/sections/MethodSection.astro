---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import { homeContent } from "../../content/home";
import "./method-section.css";
---

<Section id="metodo">
  <Container>
    <h2 class="method-section__title">{homeContent.method.title}</h2>
    <p class="method-section__description">{homeContent.method.description}</p>

    <Grid columns={1} gap="md">
      {homeContent.method.steps.map((step) => (
        <div class="method-section__step">
          <span>{String(step.order).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </Grid>
  </Container>
</Section>
