---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { homeContent } from "../../content/home";
import "./diagnosis-section.css";
---

<Section id="diagnostico" background="dark">
  <Container>
    <div class="diagnosis-section__content" data-scroll-reveal="right">
      <h2>{homeContent.diagnosis.title}</h2>
      <p>{homeContent.diagnosis.description}</p>

      <div class="diagnosis-section__cta">
        {homeContent.diagnosis.actions.map((action, idx) => (
          <a
            href={action.href}
            class={idx === 0 ? "diagnosis-cta__primary" : "diagnosis-cta__secondary"}
            target={action.href.startsWith("http") ? "_blank" : undefined}
            rel={action.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {action.label}
            {action.href.startsWith("http") && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 6px;">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </Container>
</Section>
