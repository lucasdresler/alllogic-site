---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { homeContent } from "../../content/home";
import "./cta-section.css";
---

<Section id="cta-final" background="dark">
  <Container>
    <div class="cta-section__content" data-scroll-reveal="up">
      <h2>{homeContent.cta.title}</h2>
      <p>{homeContent.cta.description}</p>
      <div class="cta-section__actions">
        {homeContent.cta.actions.map((action, idx) => (
          <a
            class={idx === 0 ? "cta-section__link cta-link__primary" : "cta-section__link cta-link__secondary"}
            href={action.href}
            target={action.href.startsWith("http") ? "_blank" : undefined}
            rel={action.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {action.label}
          </a>
        ))}
      </div>
    </div>
  </Container>
</Section>
