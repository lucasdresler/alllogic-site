---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import { homeContent } from "../../content/home";
import "./hero-section.css";
---

<Section spacing="lg">
  <Container>
    <div class="hero-section__content">
      <p class="hero-section__eyebrow micro-float">{homeContent.hero.eyebrow}</p>
      <h1>{homeContent.hero.title}</h1>
      <p class="hero-section__description" set:html={homeContent.hero.description} />

      <div class="hero-section__ctas">
        {homeContent.hero.actions.map((action, index) => (
          <a
            href={action.href}
            class:list={[
              "hero-section__cta",
              "btn-interactive",
              index === 0 ? "hero-section__cta--primary" : "hero-section__cta--secondary",
            ]}
          >
            {action.label}
          </a>
        ))}
      </div>
    </div>
  </Container>
</Section>
