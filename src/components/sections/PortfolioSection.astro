---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import { homeContent } from "../../content/home";
import "./portfolio-section.css";
---

<Section id="portfolio" background="light">
  <Container>
    <div class="portfolio-section__header">
      <h2>{homeContent.portfolio.title}</h2>
      <p>{homeContent.portfolio.description}</p>
    </div>

    <Grid columns={3} gap="lg">
      {homeContent.portfolio.projects.map((project) => (
        <article class="portfolio-section__block" data-scroll-reveal="right">
          {project.image && (
            <div class="portfolio-section__image">
              <img src={project.image} alt={`Prévia do projeto ${project.title}`} />
            </div>
          )}

          <div class="portfolio-section__content">
            <span class="portfolio-section__type">{project.type}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a
              class="portfolio-section__link"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visitar projeto
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </Grid>

    <p class="portfolio-section__closing">{homeContent.portfolio.closing}</p>
  </Container>
</Section>
