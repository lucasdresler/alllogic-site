---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import { homeContent } from "../../content/home";
import "./solutions-section.css";
---

<Section id="solucoes">
  <Container>
    <div class="solutions-section__header" data-scroll-reveal="fade">
      <h2>{homeContent.solutions.title}</h2>
      <p>{homeContent.solutions.description}</p>
    </div>

    <Grid columns={3} gap="lg">
      {homeContent.solutions.items.map((solution) => (
        <div class="solutions-section__block" data-scroll-reveal="up">
          <h3>{solution.title}</h3>
          <p>{solution.description}</p>
          {solution.href && (
            <a href={solution.href} class="solutions-section__link">
              {solution.linkText ?? "Saiba mais"} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      ))}
    </Grid>
  </Container>
</Section>
