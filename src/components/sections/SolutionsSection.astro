---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import { homeContent } from "../../content/home";
import "./solutions-section.css";
---

<Section>
  <Container>
    <div class="solutions-section__header">
      <h2>{homeContent.solutions.title}</h2>
      <p>{homeContent.solutions.description}</p>
    </div>

    <Grid columns={3} gap="lg">
      <div class="solutions-section__block">
        <h3>Solução 1</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 2</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 3</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 4</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 5</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 6</h3>
        <p>Descrição provisória.</p>
      </div>
    </Grid>
  </Container>
</Section>
