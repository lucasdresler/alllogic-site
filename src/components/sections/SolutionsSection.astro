      <h2>Título da seção</h2>
      <p>Texto provisório.</p>
    </div>

    <Grid columns={3} gap="lg">
      <div class="solutions-section__block">
        <h3>Solução 1</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 2</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 3</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 4</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 5</h3>
        <p>Descrição provisória.</p>
      </div>

      <div class="solutions-section__block">
        <h3>Solução 6</h3>
        <p>Descrição provisória.</p>
      </div>
    </Grid>
  </Container>
