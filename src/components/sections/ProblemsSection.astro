---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import { homeContent } from "../../content/home";
import "./problems-section.css";
---

<Section id="problemas" background="light">
  <Container>
    <div class="problems-section__header">
      <h2>{homeContent.problems.title}</h2>
      <p>{homeContent.problems.description}</p>
    </div>

    <Grid columns={3} gap="lg">
      {homeContent.problems.items.map((problem) => (
        <div class="problems-section__card">
          <h3>{problem.title}</h3>
          <p>{problem.description}</p>
        </div>
      ))}
    </Grid>

    <p class="problems-section__closing">{homeContent.problems.closing}</p>
  </Container>
</Section>
