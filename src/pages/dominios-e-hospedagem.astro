---
import MainLayout from "../layouts/MainLayout.astro";
import DomainsHeroSection from "../components/domains/DomainsHeroSection.astro";
import DomainSearchSection from "../components/domains/DomainSearchSection.astro";
import HostingSection from "../components/domains/HostingSection.astro";
const hostingSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Registro de Domínios e Hospedagem cPanel de Alta Performance",
    serviceType: "Hospedagem de Sites e Registro de Domínios",
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
    description:
      "Hospedagem profissional cPanel com isolamento CloudLinux, contas de e-mail corporativo, bancos de dados MySQL, certificado SSL grátis automático e gestão técnica de DNS.",
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "BRL",
      lowPrice: "23.90",
      highPrice: "149.90",
      offerCount: "4",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Domínios e Hospedagem",
        item: "https://alllogiconline.com.br/dominios-e-hospedagem",
      },
    ],
  },
];
---

<MainLayout
  title="Registro de Domínio .com.br e Hospedagem cPanel com SSL | AllLogic Online"
  description="Registre seu domínio oficial e conte com hospedagem cPanel de alta performance com SSL grátis, gestão de DNS e suporte técnico especializado da AllLogic Online."
  schema={hostingSchema}
>
  <DomainsHeroSection />
  <DomainSearchSection />
  <HostingSection />
</MainLayout>
