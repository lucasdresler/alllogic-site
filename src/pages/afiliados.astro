---
import MainLayout from "../layouts/MainLayout.astro";
import AffiliatesHeroSection from "../components/affiliates/AffiliatesHeroSection.astro";
import AffiliatesCommissionSection from "../components/affiliates/AffiliatesCommissionSection.astro";
import AffiliatesBenefitsSection from "../components/affiliates/AffiliatesBenefitsSection.astro";
import AffiliatesAudienceSection from "../components/affiliates/AffiliatesAudienceSection.astro";
import AffiliatesTutorialSection from "../components/affiliates/AffiliatesTutorialSection.astro";
import AffiliatesRegisterSection from "../components/affiliates/AffiliatesRegisterSection.astro";
import AffiliatesFaqSection from "../components/affiliates/AffiliatesFaqSection.astro";
import AffiliatesCtaSection from "../components/affiliates/AffiliatesCtaSection.astro";
import { afiliadosContent } from "../content/afiliados";

const affiliatesSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AllLogic Partners — Programa Oficial de Afiliados e Parceiros",
    serviceType: "Programa de Afiliados e Parcerias Comerciais",
    description: afiliadosContent.meta.description,
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
    termsOfService: "https://alllogiconline.com.br/termos-de-uso",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: afiliadosContent.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Parcerias",
        item: "https://alllogiconline.com.br/afiliados",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Programa de Afiliados",
        item: "https://alllogiconline.com.br/afiliados",
      },
    ],
  },
];
---

<MainLayout
  title={afiliadosContent.meta.title}
  description={afiliadosContent.meta.description}
  schema={affiliatesSchema}
>
  <AffiliatesHeroSection />
  <AffiliatesCommissionSection />
  <AffiliatesBenefitsSection />
  <AffiliatesAudienceSection />
  <AffiliatesTutorialSection />
  <AffiliatesRegisterSection />
  <AffiliatesFaqSection />
  <AffiliatesCtaSection />
</MainLayout>
