---
import MainLayout from "../layouts/MainLayout.astro";
import ReputacaoHeroSection from "../components/agillex-reputacao/ReputacaoHeroSection.astro";
import ReputacaoAudienceSection from "../components/agillex-reputacao/ReputacaoAudienceSection.astro";
import ReputacaoFeaturesSection from "../components/agillex-reputacao/ReputacaoFeaturesSection.astro";
import ReputacaoPricingSection from "../components/agillex-reputacao/ReputacaoPricingSection.astro";
import ReputacaoFaqSection from "../components/agillex-reputacao/ReputacaoFaqSection.astro";
import ReputacaoTrialSection from "../components/agillex-reputacao/ReputacaoTrialSection.astro";
import { agillexReputacaoContent } from "../content/agillex-reputacao";

const reputacaoSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Agillex Reputação",
    operatingSystem: "Web, WhatsApp Cloud API, Google Business Profile",
    applicationCategory: "MarketingApplication",
    description: agillexReputacaoContent.meta.description,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "BRL",
      lowPrice: "49.00",
      highPrice: "129.00",
      offerCount: "3",
    },
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: agillexReputacaoContent.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Família Agillex",
        item: "https://alllogiconline.com.br/#solucoes",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Agillex Reputação",
        item: "https://alllogiconline.com.br/agillex-reputacao",
      },
    ],
  },
];
---

<MainLayout
  title={agillexReputacaoContent.meta.title}
  description={agillexReputacaoContent.meta.description}
  schema={reputacaoSchema}
>
  <ReputacaoHeroSection />
  <ReputacaoAudienceSection />
  <ReputacaoFeaturesSection />
  <ReputacaoPricingSection />
  <ReputacaoFaqSection />
  <ReputacaoTrialSection />
</MainLayout>
