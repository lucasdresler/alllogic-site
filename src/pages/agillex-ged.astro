---
import MainLayout from "../layouts/MainLayout.astro";
import GedHeroSection from "../components/agillex-ged/GedHeroSection.astro";
import GedAudienceSection from "../components/agillex-ged/GedAudienceSection.astro";
import GedFeaturesSection from "../components/agillex-ged/GedFeaturesSection.astro";
import GedPricingSection from "../components/agillex-ged/GedPricingSection.astro";
import GedFaqSection from "../components/agillex-ged/GedFaqSection.astro";
import GedTrialSection from "../components/agillex-ged/GedTrialSection.astro";
import { agillexGedContent } from "../content/agillex-ged";

const gedSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Agillex GED",
    operatingSystem: "Web, Cloud, WhatsApp Cloud API",
    applicationCategory: "BusinessApplication",
    description: agillexGedContent.meta.description,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "BRL",
      lowPrice: "49.00",
      highPrice: "149.00",
      offerCount: "3",
    },
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: agillexGedContent.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Família Agillex",
        item: "https://alllogiconline.com.br/#solucoes",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Agillex GED",
        item: "https://alllogiconline.com.br/agillex-ged",
      },
    ],
  },
];
---

<MainLayout
  title={agillexGedContent.meta.title}
  description={agillexGedContent.meta.description}
  canonical="https://alllogiconline.com.br/agillex-ged"
  schema={gedSchema}
>
  <GedHeroSection />
  <GedAudienceSection />
  <GedFeaturesSection />
  <GedPricingSection />
  <GedFaqSection />
  <GedTrialSection />
</MainLayout>
