---
import MainLayout from "../layouts/MainLayout.astro";
import AtendimentoHeroSection from "../components/agillex-atendimento/AtendimentoHeroSection.astro";
import AtendimentoAudienceSection from "../components/agillex-atendimento/AtendimentoAudienceSection.astro";
import AtendimentoFeaturesSection from "../components/agillex-atendimento/AtendimentoFeaturesSection.astro";
import AtendimentoDemoSection from "../components/agillex-atendimento/AtendimentoDemoSection.astro";
import AtendimentoPricingSection from "../components/agillex-atendimento/AtendimentoPricingSection.astro";
import AtendimentoFaqSection from "../components/agillex-atendimento/AtendimentoFaqSection.astro";
import AtendimentoTrialSection from "../components/agillex-atendimento/AtendimentoTrialSection.astro";
import { agillexAtendimentoContent } from "../content/agillex-atendimento";

const atendimentoSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Agilex Atende",
    operatingSystem: "Web, WhatsApp Cloud API",
    applicationCategory: "CustomerServiceApplication",
    description: agillexAtendimentoContent.meta.description,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "BRL",
      lowPrice: "147.00",
      highPrice: "497.00",
      offerCount: "3",
    },
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: agillexAtendimentoContent.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Família Agillex",
        item: "https://alllogiconline.com.br/#solucoes",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Agilex Atende",
        item: "https://alllogiconline.com.br/agilex-atende",
      },
    ],
  },
];
---

<MainLayout
  title={agillexAtendimentoContent.meta.title}
  description={agillexAtendimentoContent.meta.description}
  schema={atendimentoSchema}
>
  <AtendimentoHeroSection />
  <AtendimentoAudienceSection />
  <AtendimentoFeaturesSection />
  <AtendimentoDemoSection />
  <AtendimentoPricingSection />
  <AtendimentoFaqSection />
  <AtendimentoTrialSection />
</MainLayout>
