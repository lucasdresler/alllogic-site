---
import MainLayout from "../layouts/MainLayout.astro";
import CobrancaHeroSection from "../components/agillex-cobranca/CobrancaHeroSection.astro";
import CobrancaAudienceSection from "../components/agillex-cobranca/CobrancaAudienceSection.astro";
import CobrancaFeaturesSection from "../components/agillex-cobranca/CobrancaFeaturesSection.astro";
import CobrancaPricingSection from "../components/agillex-cobranca/CobrancaPricingSection.astro";
import CobrancaFaqSection from "../components/agillex-cobranca/CobrancaFaqSection.astro";
import CobrancaTrialSection from "../components/agillex-cobranca/CobrancaTrialSection.astro";
import { agillexCobrancaContent } from "../content/agillex-cobranca";

const cobrancaSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Agillex Cobrança",
    operatingSystem: "Web, WhatsApp Cloud API, Asaas Pix",
    applicationCategory: "FinanceApplication",
    description: agillexCobrancaContent.meta.description,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "BRL",
      lowPrice: "49.00",
      highPrice: "149.00",
      offerCount: "3",
    },
    provider: {
      "@type": "Organization",
      name: "AllLogic Online",
      url: "https://alllogiconline.com.br",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: agillexCobrancaContent.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: "https://alllogiconline.com.br",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Família Agillex",
        item: "https://alllogiconline.com.br/#solucoes",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Agillex Cobrança",
        item: "https://alllogiconline.com.br/agillex-cobranca",
      },
    ],
  },
];
---

<MainLayout
  title={agillexCobrancaContent.meta.title}
  description={agillexCobrancaContent.meta.description}
  schema={cobrancaSchema}
>
  <CobrancaHeroSection />
  <CobrancaAudienceSection />
  <CobrancaFeaturesSection />
  <CobrancaPricingSection />
  <CobrancaFaqSection />
  <CobrancaTrialSection />
</MainLayout>
